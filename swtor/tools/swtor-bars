#!/usr/bin/env python3
"""Match the SWTOR deck profile to the quickbars you actually use.

SWTOR keeps your keybinds on its servers, so nothing on this machine can read
them. What it does keep on disk is your interface layout, and that is the half
worth following: this reads the GUI profile your character is using and dims
every deck key whose quickbar is switched off, or whose slot is past the end of
the bar. Dimmed keys keep their binds; they are just slots you can't see.

The game binds the main and companion quickbars out of the box and leaves
quickbars 2-6 unbound, so those pages ship dim. Once you have bound a bar in
Preferences > Key Bindings > Quickbar, tell the deck with --bound:

  swtor-bars --bound 2,3     # I have bound quickbars 2 and 3 in game
  swtor-bars --unbound 3     # ...and undo that for 3

Usage: swtor-bars [--settings-dir DIR] [--character NAME] [--profile PATH]
                  [--bound BARS] [--unbound BARS] [--dry-run] [--quiet]

Only the key lines change; comments and layout in the profile are kept. Nothing
in the game folder or the Wine prefix is written to.
"""

import argparse
import configparser
import glob
import os
import re
import sys
import tomllib
import xml.etree.ElementTree as ET

CONFIG_DIR = os.environ.get("GALLEON_DECK_CONFIG") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "galleon-deck")
STEAM_APPID = "1286830"
# Inside a Wine prefix, from drive_c:
SETTINGS_TAIL = os.path.join("users", "*", "AppData", "Local", "SWTOR", "swtor", "settings")


# ------------------------------------------------------------ game files ---

def steam_libraries():
    """Every Steam library folder, from libraryfolders.vdf."""
    roots = ["~/.local/share/Steam", "~/.steam/steam", "~/.steam/root",
             "~/.var/app/com.valvesoftware.Steam/.local/share/Steam"]
    libs = []
    for root in roots:
        vdf = os.path.expanduser(os.path.join(root, "steamapps", "libraryfolders.vdf"))
        if not os.path.isfile(vdf):
            continue
        libs.append(os.path.dirname(os.path.dirname(vdf)))
        try:
            with open(vdf, encoding="utf-8", errors="replace") as f:
                libs += re.findall(r'"path"\s+"([^"]+)"', f.read())
        except OSError:
            pass
    return libs


def find_settings_dirs():
    """SWTOR settings folders, most likely first."""
    found = []
    for lib in steam_libraries():
        found += glob.glob(os.path.join(lib, "steamapps", "compatdata", STEAM_APPID,
                                        "pfx", "drive_c", SETTINGS_TAIL))
    for prefix in ("~/Games/*", "~/Games/*/*", "~/.local/share/lutris/prefixes/*",
                   "~/.wine", "~/.wine*", "~/.local/share/bottles/bottles/*"):
        found += glob.glob(os.path.join(os.path.expanduser(prefix), "drive_c", SETTINGS_TAIL))
    seen = []
    for d in found:
        if os.path.isdir(d) and d not in seen:
            seen.append(d)
    return seen


def gui_profile_path(settings, character=None):
    """The GUI profile XML the character last used, and the character's name.

    Each character has a `<server>_<name>_PlayerGUIState.ini` naming its current
    profile; the most recently written one is whoever you played last.
    """
    states = sorted(glob.glob(os.path.join(settings, "*_PlayerGUIState.ini")),
                    key=os.path.getmtime, reverse=True)
    if character:
        want = character.lower()
        states = [s for s in states
                  if want in os.path.basename(s)[:-len("_PlayerGUIState.ini")].lower()]
        if not states:
            raise LookupError(f"no character matching {character!r} in {settings}")
    for state in states:
        name = os.path.basename(state)[:-len("_PlayerGUIState.ini")]
        name = name.split("_", 1)[1] if "_" in name else name
        ini = configparser.ConfigParser(interpolation=None)
        ini.optionxform = str
        try:
            ini.read(state, encoding="utf-8")
            profile = ini.get("Settings", "GUI_Current_Profile", fallback="").strip()
        except (configparser.Error, OSError):
            continue
        if profile:
            path = os.path.join(settings, "GUIProfiles", profile + ".xml")
            if os.path.isfile(path):
                return path, name
    # No usable state file: fall back to the newest profile in the folder.
    xmls = sorted(glob.glob(os.path.join(settings, "GUIProfiles", "*.xml")),
                  key=os.path.getmtime, reverse=True)
    if xmls:
        return xmls[0], os.path.splitext(os.path.basename(xmls[0]))[0]
    raise LookupError(f"no GUI profile in {settings}")


def quickbars(xml_path):
    """{bar: slots you can see} for quickbars 1-6 and the companion bar. A bar
    that is switched off, or missing from the profile, has 0 slots."""
    root = ET.parse(xml_path).getroot()

    def value(bar, field, default):
        node = bar.find(field)
        if node is None or node.get("Value") is None:
            return default
        try:
            return float(node.get("Value"))
        except ValueError:
            return default

    bars = {}
    for key, element in [(n, f"QuickBar{n}") for n in range(1, 7)] + [("companion", "CompanionBar")]:
        bar = root.find(element)
        if bar is None:
            bars[key] = 0
            continue
        enabled = value(bar, "enabled", 1.0) >= 0.5
        bars[key] = int(value(bar, "NumVisible", 12.0)) if enabled else 0
    return bars


# -------------------------------------------------------------- profile ---

def toml_str(text):
    out = []
    for ch in text:
        o = ord(ch)
        if ch in '"\\':
            out.append("\\" + ch)
        elif o < 0x20 or 0xE000 <= o <= 0xF8FF:
            out.append(f"\\u{o:04X}")
        elif o > 0xFFFF:
            out.append(f"\\U{o:08X}")
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'


def toml_inline(d):
    def value(v):
        if isinstance(v, bool):
            return "true" if v else "false"
        if isinstance(v, (int, float)):
            return repr(v)
        return toml_str(str(v))
    return "{ " + ", ".join(f"{k} = {value(v)}" for k, v in d.items()) + " }"


def bar_name(bar):
    return "companion bar" if bar == "companion" else f"quickbar {bar}"


def sync(profile, bars, bound=(), unbound=(), dry_run=False):
    """Dim the deck keys whose quickbar slot isn't on screen or isn't bound in
    game, and un-dim the rest. Returns (report lines, keys left dim)."""
    with open(profile) as f:
        lines = f.read().split("\n")
    report, dimmed = [], 0
    for n, line in enumerate(lines):
        if "swtor_bar" not in line:
            continue
        m = re.match(r"^(\s*)(\{.*\})(\s*,?\s*(#.*)?)$", line)
        if not m:
            continue
        try:
            key = tomllib.loads("k = " + m.group(2))["k"]
        except tomllib.TOMLDecodeError:
            continue
        bar, slot = key.get("swtor_bar"), key.get("swtor_slot")
        if not isinstance(slot, int) or not (bar == "companion" or isinstance(bar, int)):
            continue

        was_dim = bool(key.get("swtor_off"))
        new = {k: v for k, v in key.items() if k != "swtor_off"}
        if was_dim:
            new.pop("fg", None)  # we dimmed it; un-dim before deciding again
        if bar in bound:
            new.pop("swtor_unbound", None)
        elif bar in unbound:
            new["swtor_unbound"] = True

        no_bind = bool(new.get("swtor_unbound"))
        visible = slot <= bars.get(bar, 0)
        if no_bind:
            why = f"{bar_name(bar)} isn't bound in game"
        elif not visible:
            why = (f"{bar_name(bar)} is off" if not bars.get(bar, 0)
                   else f"{bar_name(bar)} shows {bars[bar]} slots")
        else:
            why = None
        if why:
            new["fg"] = "dim"
            new["swtor_off"] = True
            dimmed += 1
        if bool(why) != was_dim:
            label = key.get("label", slot)
            where = f"{bar_name(bar)} slot {slot}"
            report.append(f"  {where:<24} {'dim (' + why + ')' if why else 'lit'}")
        lines[n] = m.group(1) + toml_inline(new) + m.group(3)
    if not dry_run:
        with open(profile + ".tmp", "w") as f:
            f.write("\n".join(lines))
        os.replace(profile + ".tmp", profile)
    return report, dimmed


def bar_list(text):
    """"2,3" or "2 3" -> {2, 3}; "companion" is allowed too."""
    out = set()
    for part in re.split(r"[,\s]+", text.strip()):
        if not part:
            continue
        if part.lower().startswith("comp"):
            out.add("companion")
        elif part.isdigit() and 1 <= int(part) <= 6:
            out.add(int(part))
        else:
            raise argparse.ArgumentTypeError(f"not a quickbar: {part!r} (use 1-6 or companion)")
    return out


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--settings-dir", help="SWTOR's settings folder inside the Wine prefix")
    ap.add_argument("--character", help="which character's layout to follow (default: last played)")
    ap.add_argument("--profile", default=os.path.join(CONFIG_DIR, "profiles", "swtor.toml"))
    ap.add_argument("--bound", type=bar_list, default=set(), metavar="BARS",
                    help="quickbars you have bound in game, e.g. 2,3")
    ap.add_argument("--unbound", type=bar_list, default=set(), metavar="BARS",
                    help="quickbars you have unbound again")
    ap.add_argument("--dry-run", action="store_true", help="show what would change")
    ap.add_argument("--quiet", action="store_true", help="print only changes")
    args = ap.parse_args()

    if not os.path.isfile(args.profile):
        sys.exit(f"swtor-bars: no profile at {args.profile}")
    clash = args.bound & args.unbound
    if clash:
        sys.exit(f"swtor-bars: {', '.join(bar_name(b) for b in sorted(clash, key=str))} "
                 "given as both bound and unbound")

    dirs = [args.settings_dir] if args.settings_dir else find_settings_dirs()
    dirs = [d for d in dirs if os.path.isdir(os.path.join(d, "GUIProfiles"))]
    bars, character, xml_path = None, None, None
    if dirs:
        try:
            xml_path, character = gui_profile_path(dirs[0], args.character)
            bars = quickbars(xml_path)
        except (LookupError, ET.ParseError, OSError) as e:
            print(f"swtor-bars: {e}", file=sys.stderr)
    if bars is None:
        # Not an error: the game may simply not have been run yet, and a fresh
        # install should keep every slot rather than hide the lot.
        print("swtor-bars: no SWTOR interface layout found, so every slot is treated as "
              "visible. Run the game once, or pass --settings-dir.", file=sys.stderr)
        bars = {n: 12 for n in list(range(1, 7)) + ["companion"]}

    report, dimmed = sync(args.profile, bars, args.bound, args.unbound, args.dry_run)
    if not args.quiet or report:
        if character:
            shown = ", ".join(f"{k}:{'off' if not v else v}" for k, v in bars.items())
            print(f"SWTOR quickbars for {character} ({os.path.basename(xml_path)}) - {shown}")
        print("\n".join(report) if report else f"  deck already matches ({dimmed} keys dim)")
        if args.dry_run:
            print("(dry run: nothing written)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
